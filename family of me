<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Family Tree</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding: 30px 18px;
    font-family: Georgia, serif;
    background: #f7f3ed;
    color: #44382f;
}

header {
    text-align: center;
    padding: 35px 15px;
}

h1 {
    font-size: 40px;
    font-weight: normal;
    letter-spacing: 2px;
}

.subtitle {
    color: #927d69;
    font-style: italic;
}

.container {
    max-width: 1250px;
    margin: auto;
}

h2 {
    text-align: center;
    font-size: 23px;
    font-weight: normal;
    letter-spacing: 2px;
    margin-bottom: 22px;
}

h3 {
    font-size: 17px;
    font-weight: normal;
    color: #806b56;
}

.branches {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
    align-items: start;
}

.branch {
    background: #fffdf9;
    border: 1px solid #dfd2c1;
    border-radius: 15px;
    padding: 22px;
}

.paternal {
    border-top: 5px solid #a88769;
}

.maternal {
    border-top: 5px solid #b99b80;
}

.grandparents {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 25px;
}

.person {
    background: #f4ede4;
    border: 1px solid #dfd2c1;
    border-radius: 9px;
    padding: 13px 9px;
    text-align: center;
    font-size: 14px;
}

.role {
    display: block;
    font-size: 10px;
    color: #927d69;
    margin-bottom: 6px;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.date {
    display: block;
    font-size: 12px;
    color: #968575;
    margin-top: 5px;
}

.member {
    background: #faf6f0;
    border-left: 3px solid #c0a184;
    border-radius: 6px;
    padding: 13px;
    margin: 12px 0;
}

.maternal .member {
    border-left-color: #b99b80;
}

.member strong {
    font-weight: normal;
    font-size: 15px;
}

.children {
    border-top: 1px solid #e5ddd2;
    margin-top: 9px;
    padding-top: 9px;
    font-size: 13px;
    line-height: 1.9;
    color: #796b5e;
}

.highlight {
    background: #fff8ec;
    border: 1px solid #d8c5ad;
}

.marriage {
    max-width: 750px;
    margin: 35px auto;
    padding: 25px;
    background: #fffdf9;
    border: 1px solid #d8c5ad;
    border-radius: 15px;
    text-align: center;
}

.couple {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
}

.heart {
    color: #a77b70;
    font-size: 23px;
}

.immediate {
    max-width: 650px;
    margin: 35px auto;
    padding: 25px;
    background: #eee8df;
    border: 1px solid #cbbba7;
    border-radius: 15px;
    text-align: center;
}

footer {
    text-align: center;
    margin-top: 35px;
    color: #927d69;
    font-style: italic;
}

@media(max-width: 750px) {
    .branches {
        grid-template-columns: 1fr;
    }

    h1 {
        font-size: 30px;
    }
}
</style>

</head>

